{
  "rules": {
    ".read": false,
    ".write": false,
    "rom": {
      "$kode": {
        "$kart": {
          ".read": "auth != null && $kode.matches(/^[A-Z0-9]{3,8}$/) && $kart.matches(/^[a-z]{1,20}$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $kode.matches(/^[A-Z0-9]{3,8}$/) && $kart.matches(/^[a-z]{1,20}$/)",
            ".validate": "newData.hasChildren(['a', 'd', 'figur', 'nivaa', 'x', 'y'])",
            "a": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() < 25" },
            "d": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() < 25" },
            "figur": { ".validate": "newData.isString() && newData.val().matches(/^[a-z_]{1,24}$/)" },
            "nivaa": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 20" },
            "x": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() < 100" },
            "y": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() < 100" },
            "$annet": { ".validate": false }
          }
        }
      }
    }
  }
}
